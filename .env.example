# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" is gitignored - it is never committed, so each developer/environment
# can point at a different backend without touching build files or code.
#
# Must include the trailing slash and the "/api/" prefix your backend uses
# (Retrofit requires base URLs to end with "/"). Do not wrap the value in quotes.
BASE_URL=https://your-domain.com/api/
